# Put your key here on the VPS. Never share or commit the real .env.
YOUTUBE_API_KEY=
# Start in demo mode to test without a key.
PTUBE_DEMO=1
# Unofficial yt-dlp playback is distinct from the official search API.
ENABLE_UNOFFICIAL_PLAYBACK=0
DAILY_SEARCH_LIMIT=40
# Initially reachable only from the VPS itself.
# Set to 0.0.0.0 to allow remote PSP connections; protect the port with your firewall.
PTUBE_BIND=127.0.0.1
PTUBE_PORT=8080
